local function applyPropColor(prop, color)
	if not prop or not color then return end
	local key = tostring(prop:GetDebugId())
	if lastAppliedColors[key] == tostring(color) then return end
	lastAppliedColors[key] = tostring(color)
	task.spawn(function()
		local crR = prop:FindFirstChild("ChangePropColor", true)
		if crR then
			pcall(function()
				if crR:IsA("RemoteFunction") then crR:InvokeServer(color)
				elseif crR:IsA("RemoteEvent") then crR:FireServer(color) end
			end)
		end
		for _, child in ipairs(prop:GetDescendants()) do
			if child.Name == "SetColor" or child.Name == "ChangeColor" or child.Name == "ChangePropColor"
				or child.Name == "Paint"
				or (child.Name == "Color" and (child:IsA("RemoteEvent") or child:IsA("RemoteFunction"))) then
				if child:IsA("RemoteFunction") then pcall(function() child:InvokeServer(color) end)
				elseif child:IsA("RemoteEvent") then pcall(function() child:FireServer(color) end) end
			end
		end
	end)
	pcall(function()
		if prop:IsA("BasePart") then prop.Color = color
		else
			for _, part in ipairs(prop:GetDescendants()) do
				if part:IsA("BasePart") and not part.Name:lower():find("selection") then part.Color = color end
			end
		end
	end)
end

local RS = game:GetService("RunService")
RS.Heartbeat:Connect(function()
	local s = _G.AbyssShared
	if s then
		if s.petMode ~= nil then petMode = s.petMode end
		if s.buildScale then buildScale = s.buildScale end
		if s.followTargetName and Players:FindFirstChild(s.followTargetName) then
			followTargetPlayer = Players[s.followTargetName]
		end
	end
	if not petMode then return end
	local entry = BuildPresets[CurrentBuild]
	local offsets = nil
	if entry then
		if entry.offsets then offsets = entry.offsets
		elseif type(entry) == "table" and entry[1] and (entry[1].CF or typeof(entry[1]) == "Vector3") then
			offsets = entry
		end
	end
	if not offsets then return end
	local character = (followTargetPlayer or LP).Character
	local root = character and character:FindFirstChild("HumanoidRootPart")
	if not root then return end
	local baseCF = root.CFrame
	local scale = buildScale or 1
	local totalOffsets = #offsets
	for idx, prop in pairs(boundProps) do
		if prop and prop.Parent and not isCharacterOrPlayer(prop) then
			local targetCF, itemColor
			if idx <= totalOffsets then
				local data = offsets[idx]
				local relCF
				if typeof(data) == "Vector3" then relCF = CFrame.new(data)
				elseif typeof(data) == "CFrame" then relCF = data
				elseif typeof(data) == "table" then
					relCF = data.CF or CFrame.new()
					itemColor = data.Color
				end
				if relCF then
					targetCF = baseCF * CFrame.new(relCF.Position * scale) * relCF.Rotation
				end
			end
			if targetCF then
				local cfR = boundPropRemotes[prop]
				if not cfR then
					cfR = prop:FindFirstChild("SetCurrentCFrame", true)
					if cfR then boundPropRemotes[prop] = cfR end
				end
				if cfR then
					task.spawn(function()
						pcall(function()
							if cfR:IsA("RemoteFunction") then cfR:InvokeServer(targetCF)
							elseif cfR:IsA("RemoteEvent") then cfR:FireServer(targetCF) end
						end)
					end)
				end
				if itemColor then applyPropColor(prop, itemColor) end
			end
		end
	end
end)

