local function finishReRecordListOnly()
	local targetName = reRecordTargetName or (_G.AbyssReRecordProps and _G.AbyssReRecordProps.buildName)
	reRecordTargetName = nil
	_G.AbyssReRecordProps = nil
	isRecording = false
	if not targetName or #recordedPropsList == 0 then
		recordPhase = "idle"
		RecordBtn.Text = "🔴 1) INICIAR GRAVAÇÃO"
		RecordBtn.BackgroundColor3 = STYLES.GreenColor
		statusLbl.Text = (not targetName) and "1) Grave os props colocados" or "Nenhum prop gravado"
		statusLbl.TextColor3 = STYLES.SelectNeon
		tipLbl.Text = "Coloque os props no mapa enquanto grava"
		updateRecordUI()
		return
	end
	local listCopy = {}
	for i, p in ipairs(recordedPropsList) do
		listCopy[i] = { name = p.name, category = p.category }
	end
	local ok = savePropsListOnly(targetName, listCopy)
	recordPhase = "idle"
	RecordBtn.Text = "🔴 1) INICIAR GRAVAÇÃO"
	RecordBtn.BackgroundColor3 = STYLES.GreenColor
	SavePoseBtn.Visible = false
	CustomNameBox.Visible = false
	statusLbl.Text = ok and ("✅ Lista salva em \"" .. targetName .. "\" (" .. #listCopy .. ")") or "❌ Falha ao salvar lista"
	statusLbl.TextColor3 = ok and STYLES.GreenColor or STYLES.RedColor
	tipLbl.Text = "Coloque os props no mapa enquanto grava"
	updateRecordUI()
