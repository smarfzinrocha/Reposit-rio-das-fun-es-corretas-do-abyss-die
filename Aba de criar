local function addRecordedProp(name, category)
	if typeof(name) ~= "string" or typeof(category) ~= "string" then return end
	name = name:gsub("%s+", "")
	category = category:gsub("%s+", "")
	if name == "" or category == "" then return end
	table.insert(recordedPropsList, { name = name, category = category })
	if updateRecordUI then updateRecordUI() end
	print("[Criar] + " .. name .. " | " .. category .. " (total: " .. #recordedPropsList .. ")")
end

local hookOk = false
pcall(function()
	if not hookmetamethod or not getnamecallmethod or not newcclosure then return end
	local oldNamecall
	oldNamecall = hookmetamethod(game, "__namecall", newcclosure(function(self, ...)
		local method = getnamecallmethod()
		local args = {...}
		if isRecording and recordPhase == "recording" and (method == "FireServer" or method == "fireServer") then
			local remoteName = ""
			pcall(function() remoteName = tostring(self.Name) end)
			if typeof(args[1]) == "string" and args[1] == "RequestingPropName" then
				local n = tostring(args[2] or ""):gsub("%s+", "")
				local c = tostring(args[3] or ""):gsub("%s+", "")
				if n ~= "" and c ~= "" then
					lastSelected = { name = n, category = c }
				end
			end
			if lastSelected and (
				remoteName == "Tool_PropMake"
				or remoteName:lower():find("propmake")
				or remoteName:lower():find("prop_make")
			) then
				local selName = lastSelected.name
				local selCat = lastSelected.category
				task.spawn(function()
					local countBefore = 0
					pcall(function() countBefore = #scanMapProps() end)
					task.wait(0.45)
					if not isRecording or recordPhase ~= "recording" then return end
					local countAfter = 0
					pcall(function() countAfter = #scanMapProps() end)
					if countAfter > countBefore then
						addRecordedProp(selName, selCat)
					end
				end)
			end
		end
		return oldNamecall(self, ...)
	end))
	hookOk = true
end)
if not hookOk then
	warn("[Criar] hookmetamethod indisponível — gravação de props por colocação pode não funcionar neste executor")
end

