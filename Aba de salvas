local function getPropGeometry(prop)
	if not prop then return {Sides = 6, Size = Vector3.one, Mesh = ""} end
	local pSize = Vector3.one
	local pSides = 6
	local pMesh = ""
	if prop:IsA("BasePart") then pSize = prop.Size
	elseif prop:IsA("Model") then local _, bboxSize = prop:GetBoundingBox() pSize = bboxSize end
	if prop:IsA("Part") then
		if prop.Shape == Enum.PartType.Block then pSides = 6
		elseif prop.Shape == Enum.PartType.Cylinder then pSides = 3
		elseif prop.Shape == Enum.PartType.Ball then pSides = 1 end
	elseif prop:IsA("WedgePart") or prop:IsA("CornerWedgePart") then pSides = 5
	elseif prop:IsA("MeshPart") then pSides = 0 pMesh = tostring(prop.MeshId) end
	local specialMesh = prop:FindFirstChildOfClass("SpecialMesh")
	if specialMesh then pMesh = tostring(specialMesh.MeshId) end
	return {
		Sides = pSides,
		Size = Vector3.new(math.floor(pSize.X*100+0.5)/100, math.floor(pSize.Y*100+0.5)/100, math.floor(pSize.Z*100+0.5)/100),
		Mesh = pMesh
	}
end

local function isCharacterOrPlayer(v)
	if not v then return true end
	if Players:GetPlayerFromCharacter(v) then return true end
	if v:FindFirstChildOfClass("Humanoid") then return true end
	if v:IsA("BasePart") and (v.Name == "HumanoidRootPart" or v.Name == "Head" or v.Name == "Torso" or v.Name == "UpperTorso") then return true end
	local parent = v.Parent
	if parent then
		if Players:GetPlayerFromCharacter(parent) then return true end
		if parent:FindFirstChildOfClass("Humanoid") then return true end
	end
	return false
end

local function scanMapProps()
	local props, added = {}, {}
	local targetName = "Prop" .. OwnerName
	local function checkAndAdd(v)
		if added[v] then return end
		if isCharacterOrPlayer(v) then return end
		local n = tostring(v.Name or "")
		if n == targetName or (n:sub(1,4) == "Prop" and n:find(OwnerName,1,true)) then
			added[v] = true
			table.insert(props, v)
		end
	end
	local wsCom = workspace:FindFirstChild("WorkspaceCom")
	if wsCom then
		for _, folder in ipairs(wsCom:GetChildren()) do
			for _, v in ipairs(folder:GetChildren()) do checkAndAdd(v) end
		end
	end
	for _, v in ipairs(workspace:GetChildren()) do checkAndAdd(v) end
	return props
end

local function getOffsets(entry)
	if not entry then return nil end
	if entry.offsets then return entry.offsets end
	-- compat formato antigo (array direto)
	if type(entry) == "table" and entry[1] and entry[1].CF then return entry end
	return nil
end

local function getPropsList(entry)
	if not entry then return {} end
	return entry.propsList or {}
end

local function loadAnimationsFromFile()
	if not readfile or not isfile or not isfile(ANIM_FILE_NAME) then return end
	local ok, raw = pcall(function() return readfile(ANIM_FILE_NAME) end)
	if not ok or not raw or raw == "" then return end
	local okDecode, decoded = pcall(function() return HS:JSONDecode(raw) end)
	if not okDecode or type(decoded) ~= "table" then return end
	local animsToLoad = decoded.Animations or decoded
	if decoded.Active then ActiveAnimations = decoded.Active end
	for buildName, types in pairs(animsToLoad) do
		BuildAnimations[buildName] = BuildAnimations[buildName] or { Walk = {}, Idle = {}, Emote = {} }
		for animType, anims in pairs(types) do
			BuildAnimations[buildName][animType] = BuildAnimations[buildName][animType] or {}
			for animName, serializedKeyframes in pairs(anims) do
				local restoredKeyframes = {}
				for _, kfTable in ipairs(serializedKeyframes) do
					if type(kfTable) == "table" then
						local propCFs = {}
						for _, comp in ipairs(kfTable) do
							if type(comp) == "table" then table.insert(propCFs, CFrame.new(unpack(comp))) end
						end
						if #propCFs > 0 then table.insert(restoredKeyframes, propCFs) end
					end
				end
				BuildAnimations[buildName][animType][animName] = restoredKeyframes
			end
		end
	end
end

local function getMissingProps(buildName)
	local entry = BuildPresets[buildName]
	if not entry then return {}, 0 end
	local offsets = getOffsets(entry) or {}
	local propsList = getPropsList(entry) or {}
	if #propsList == 0 then return {}, 0 end
	local availableProps = scanMapProps()
	local usedProps, matchedCount, missing = {}, 0, {}
	for idx, data in ipairs(offsets) do
		local targetGeom = (type(data) == "table") and data.Geom or nil
		local found = false
		if targetGeom then
			local targetSides = targetGeom.Sides or 6
			local targetSize = Vector3.new(targetGeom.Size[1] or 1, targetGeom.Size[2] or 1, targetGeom.Size[3] or 1)
			local targetMesh = targetGeom.Mesh or ""
			for _, prop in ipairs(availableProps) do
				if not usedProps[prop] then
					local propGeom = getPropGeometry(prop)
					if propGeom.Sides == targetSides and (propGeom.Size - targetSize).Magnitude < 0.2 and propGeom.Mesh == targetMesh then
						usedProps[prop] = true; found = true; matchedCount = matchedCount + 1; break
					end
				end
			end
		end
		if not found then
			local propData = propsList[idx] or propsList[#propsList]
			if propData then table.insert(missing, { propData = propData, index = idx }) end
		end
	end
	if #propsList > #offsets then
		for i = #offsets + 1, #propsList do table.insert(missing, { propData = propsList[i], index = i }) end
	end
	return missing, matchedCount
end

local function applyPropColor(prop, color)
	if not prop or not color then return end
	local key = tostring(prop:GetDebugId())
	if lastAppliedColors[key] == tostring(color) then return end
	lastAppliedColors[key] = tostring(color)
	task.spawn(function()
		local crR = prop:FindFirstChild("ChangePropColor", true)
		if crR then
			pcall(function()
				if crR:IsA("RemoteFunction") then crR:InvokeServer(color)
				elseif crR:IsA("RemoteEvent") then crR:FireServer(color) end
			end)
		end
		for _, child in ipairs(prop:GetDescendants()) do
			if child.Name == "SetColor" or child.Name == "ChangeColor" or child.Name == "ChangePropColor"
				or child.Name == "Paint"
				or (child.Name == "Color" and (child:IsA("RemoteEvent") or child:IsA("RemoteFunction"))) then
				if child:IsA("RemoteFunction") then pcall(function() child:InvokeServer(color) end)
				elseif child:IsA("RemoteEvent") then pcall(function() child:FireServer(color) end) end
			end
		end
	end)
	pcall(function()
		if prop:IsA("BasePart") then prop.Color = color
		else
			for _, part in ipairs(prop:GetDescendants()) do
				if part:IsA("BasePart") and not part.Name:lower():find("selection") then part.Color = color end
			end
		end
	end)
end

local function rebindPropsToBuild()
	boundProps = {}
	boundPropRemotes = {}
	local entry = BuildPresets[CurrentBuild]
	local offsets = getOffsets(entry)
	if not offsets then return end
	local availableProps = scanMapProps()
	local usedProps = {}
	local function cacheRemote(prop)
		if not prop then return end
		local cfR = prop:FindFirstChild("SetCurrentCFrame", true)
		if cfR then boundPropRemotes[prop] = cfR end
	end
	for idx, data in ipairs(offsets) do
		local targetGeom = (type(data) == "table") and data.Geom or nil
		if targetGeom then
			local targetSides = targetGeom.Sides or 6
			local targetSize = Vector3.new(targetGeom.Size[1] or 1, targetGeom.Size[2] or 1, targetGeom.Size[3] or 1)
			local targetMesh = targetGeom.Mesh or ""
			for _, prop in ipairs(availableProps) do
				if not usedProps[prop] then
					local propGeom = getPropGeometry(prop)
					local sizeDiff = (propGeom.Size - targetSize).Magnitude
					if propGeom.Sides == targetSides and sizeDiff < 0.2 and propGeom.Mesh == targetMesh then
						usedProps[prop] = true
						boundProps[idx] = prop
						cacheRemote(prop)
						break
					end
				end
			end
		end
	end
	for idx, _ in ipairs(offsets) do
		if not boundProps[idx] then
			for _, prop in ipairs(availableProps) do
				if not usedProps[prop] then
					usedProps[prop] = true
					boundProps[idx] = prop
					cacheRemote(prop)
					break
				end
			end
		end
	end
end

local function saveCustomBuildsToFile()
	if not writefile then return end
	local dataToSave = {}
	for _, name in ipairs(CustomKeys) do
		local entry = BuildPresets[name]
		if entry then
			local offsets = getOffsets(entry) or {}
			local propsList = getPropsList(entry)
			local serialBuild = {}
			for _, item in ipairs(offsets) do
				if typeof(item) == "table" and item.CF and item.Color then
					table.insert(serialBuild, {
						CF = {item.CF:GetComponents()},
						Color = {item.Color.R, item.Color.G, item.Color.B},
						Geom = item.Geom or {Sides=6, Size={1,1,1}, Mesh=""}
					})
				end
			end
			dataToSave[name] = { offsets = serialBuild, propsList = propsList }
		end
	end
	pcall(function() writefile(FILE_NAME, HS:JSONEncode(dataToSave)) end)
end

local function loadCustomBuildsFromFile()
	if not readfile or not isfile or not isfile(FILE_NAME) then return end
	local ok, raw = pcall(function() return readfile(FILE_NAME) end)
	if not ok or not raw or raw == "" then return end
	local okDecode, decoded = pcall(function() return HS:JSONDecode(raw) end)
	if not okDecode or type(decoded) ~= "table" then return end
	CustomKeys = {}
	for name, entry in pairs(decoded) do
		if type(entry) == "table" then
			local serialOffsets = entry.offsets or entry
			local propsList = entry.propsList or {}
			local restoredBuild = {}
			if type(serialOffsets) == "table" then
				for _, item in ipairs(serialOffsets) do
					if item.CF and item.Color then
						table.insert(restoredBuild, {
							CF = CFrame.new(unpack(item.CF)),
							Color = Color3.new(item.Color[1], item.Color[2], item.Color[3]),
							Geom = item.Geom or {Sides=6, Size={1,1,1}, Mesh=""}
						})
					end
				end
			end
			BuildPresets[name] = { offsets = restoredBuild, propsList = propsList }
			if not table.find(CustomKeys, name) then table.insert(CustomKeys, name) end
		end
	end
end

