function loadSharedTheme()
	if not readfile or not isfile or not isfile(CONFIG_FILE) then return end
	local ok, raw = pcall(function() return readfile(CONFIG_FILE) end)
	if not ok or not raw or raw == "" then return end
	local ok2, data = pcall(function() return HS:JSONDecode(raw) end)
	if not ok2 or type(data) ~= "table" then return end
	if type(data.CardColor) == "table" then
		STYLES.CardColor = Color3.new(data.CardColor[1] or 0.07, data.CardColor[2] or 0.07, data.CardColor[3] or 0.09)
	end
	if type(data.StrokeColor) == "table" then
		STYLES.StrokeColor = Color3.new(data.StrokeColor[1] or 0, data.StrokeColor[2] or 0.55, data.StrokeColor[3] or 1)
	end
	if type(data.TextColor) == "table" then
		STYLES.TextColor = Color3.new(data.TextColor[1] or 0.96, data.TextColor[2] or 0.96, data.TextColor[3] or 1)
	end
	local fonts = {
		Enum.Font.SourceSans, Enum.Font.SourceSansBold, Enum.Font.Gotham,
		Enum.Font.GothamBold, Enum.Font.Code, Enum.Font.Ubuntu
	}
	if type(data.fontIdx) == "number" and fonts[data.fontIdx] then
		currentFont = fonts[data.fontIdx]
	end
end

function applyThemeToPage(pg)
	if not pg then return end
	loadSharedTheme()
	for _, desc in ipairs(pg:GetDescendants()) do
		if desc:IsA("TextLabel") or desc:IsA("TextButton") or desc:IsA("TextBox") then
			desc.TextColor3 = STYLES.TextColor
			desc.Font = currentFont
			for _, child in ipairs(desc:GetChildren()) do
				if child:IsA("UIStroke") and child.ApplyStrokeMode == Enum.ApplyStrokeMode.Border then
					child.Color = STYLES.StrokeColor
				end
			end
		elseif desc:IsA("UIStroke") and desc.ApplyStrokeMode == Enum.ApplyStrokeMode.Border then
			desc.Color = STYLES.StrokeColor
		elseif desc:IsA("ScrollingFrame") then
			desc.ScrollBarImageColor3 = STYLES.StrokeColor
		end
		if (desc:IsA("TextButton") or desc:IsA("TextBox") or desc:IsA("Frame")) and desc.BackgroundTransparency < 0.5 then
			if desc.Name ~= "ListContainer" and desc.Name ~= "ConfirmDeleteBuild" then
				local c = desc.BackgroundColor3
				local isAction = (c.G > 0.5 and c.R < 0.5) or (c.R > 0.5 and c.G < 0.5) or (c.R > 0.8 and c.G > 0.5)
				if not isAction then desc.BackgroundColor3 = STYLES.CardColor end
			end
		end
	end
end

