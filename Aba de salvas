renderSavedBuildsList = function()
	for _, c in ipairs(listContainerSalvas:GetChildren()) do c:Destroy() end
	for _, c in ipairs(subTabBarSalvas:GetChildren()) do
		if not c:IsA("UIListLayout") then c:Destroy() end
	end

	local listLayout = Instance.new("UIListLayout")
	listLayout.SortOrder = Enum.SortOrder.LayoutOrder
	listLayout.Padding = UDim.new(0,2)
	listLayout.Parent = listContainerSalvas

	local totalBuilds = #CustomKeys
	local totalPages = math.max(1, math.ceil(totalBuilds / MAX_PER_PAGE))
	if currentPageIndex > totalPages then currentPageIndex = totalPages end

	if totalPages > 1 then
		subTabBarSalvas.Visible = true
		for p = 1, totalPages do
			local pageBtn = Instance.new("TextButton")
			pageBtn.Text = "Aba " .. p
			pageBtn.Size = UDim2.new(1/totalPages, -2, 1, 0)
			pageBtn.BackgroundColor3 = (p == currentPageIndex) and STYLES.AccentColor or STYLES.CardColor
			pageBtn.TextColor3 = STYLES.TextColor
			pageBtn.Font = Enum.Font.SourceSansBold
			pageBtn.TextSize = 8
			pageBtn.Parent = subTabBarSalvas
			applyStyle(pageBtn, 3, true)
			pageBtn.MouseButton1Click:Connect(function()
				currentPageIndex = p
				renderSavedBuildsList()
			end)
		end
	else
		subTabBarSalvas.Visible = false
	end

	local startIdx = (currentPageIndex - 1) * MAX_PER_PAGE + 1
	local endIdx = math.min(startIdx + MAX_PER_PAGE - 1, totalBuilds)

	if totalBuilds == 0 then
		local empty = Instance.new("TextLabel")
		empty.Text = "Nenhuma build salva"
		empty.Size = UDim2.new(1,0,0,20)
		empty.BackgroundTransparency = 1
		empty.TextColor3 = STYLES.TextColor
		empty.Font = Enum.Font.SourceSans
		empty.TextSize = 10
		empty.Parent = listContainerSalvas
		return
	end

	for i = startIdx, endIdx do
		local name = CustomKeys[i]
		local entry = BuildPresets[name]
		local nProps = #getPropsList(entry)

		local card = Instance.new("Frame")
		card.Size = UDim2.new(1,0,0,26)
		card.BackgroundColor3 = STYLES.CardColor
		card.Parent = listContainerSalvas
		applyStyle(card, 4, true)

		local nameLbl = Instance.new("TextLabel")
		nameLbl.Text = name .. (nProps > 0 and (" (" .. nProps .. ")") or "")
		nameLbl.Size = UDim2.new(0.40,0,1,0)
		nameLbl.BackgroundTransparency = 1
		nameLbl.TextColor3 = STYLES.TextColor
		nameLbl.Font = Enum.Font.SourceSansBold
		nameLbl.TextSize = 8
		nameLbl.TextXAlignment = Enum.TextXAlignment.Left
		nameLbl.TextTruncate = Enum.TextTruncate.AtEnd
		nameLbl.Parent = card
		local padL = Instance.new("UIPadding")
		padL.PaddingLeft = UDim.new(0,3)
		padL.Parent = nameLbl

		-- ▶ carregar pose
		local loadBtn = Instance.new("TextButton")
		loadBtn.Text = "▶"
		loadBtn.Size = UDim2.new(0.13,0,0.75,0)
		loadBtn.Position = UDim2.new(0.40,0,0.12,0)
		loadBtn.BackgroundColor3 = STYLES.GreenColor
		loadBtn.TextColor3 = STYLES.TextColor
		loadBtn.Font = Enum.Font.SourceSansBold
		loadBtn.TextSize = 10
		loadBtn.Parent = card
		applyStyle(loadBtn, 3, true)
		loadBtn.MouseButton1Click:Connect(function()
			CurrentBuild = name
			petMode = true
			lastAppliedColors = {}
			rebindPropsToBuild()
			_G.AbyssShared.CurrentBuild = name
			_G.AbyssShared.petMode = true
			task.delay(0.35, function()
				rebindPropsToBuild()
			end)
			loadBtn.Text = "✅"
			task.wait(0.8)
			loadBtn.Text = "▶"
		end)

		-- 📦 clique = auto-colocar | segurar = regravar lista
		local placeBtn = Instance.new("TextButton")
		placeBtn.Text = "📦"
		placeBtn.Size = UDim2.new(0.13,0,0.75,0)
		placeBtn.Position = UDim2.new(0.54,0,0.12,0)
		placeBtn.BackgroundColor3 = STYLES.SelectNeon
		placeBtn.TextColor3 = Color3.fromRGB(20,20,20)
		placeBtn.Font = Enum.Font.SourceSansBold
		placeBtn.TextSize = 10
		placeBtn.Parent = card
		placeBtn.ClipsDescendants = true
		applyStyle(placeBtn, 3, true)

		local holdRing = Instance.new("Frame")
		holdRing.Size = UDim2.new(0,0,0,0)
		holdRing.Position = UDim2.new(0.5,0,0.5,0)
		holdRing.AnchorPoint = Vector2.new(0.5,0.5)
		holdRing.BackgroundColor3 = Color3.fromRGB(255,255,255)
		holdRing.BackgroundTransparency = 0.35
		holdRing.BorderSizePixel = 0
		holdRing.ZIndex = 5
		holdRing.Visible = false
		holdRing.Parent = placeBtn
		Instance.new("UICorner", holdRing).CornerRadius = UDim.new(1,0)

		local HOLD_TIME, holding, holdStart, holdConn, longPressDone = 0.85, false, 0, nil, false
		local function stopHoldVisual()
			holding = false; longPressDone = false
			if holdConn then holdConn:Disconnect() holdConn = nil end
			holdRing.Visible = false; holdRing.Size = UDim2.new(0,0,0,0)
		end

		placeBtn.MouseButton1Down:Connect(function()
			holding = true; longPressDone = false; holdStart = tick()
			holdRing.Visible = true; holdRing.Size = UDim2.new(0,0,0,0)
			if holdConn then holdConn:Disconnect() end
			holdConn = game:GetService("RunService").Heartbeat:Connect(function()
				if not holding then return end
				local t = (tick() - holdStart) / HOLD_TIME
				if t >= 1 then
					longPressDone = true; holding = false
					if holdConn then holdConn:Disconnect() holdConn = nil end
					holdRing.Size = UDim2.new(1.2,0,1.2,0)
					_G.AbyssReRecordProps = { buildName = name }
					if placeStatusLbl then placeStatusLbl.Text = "Regravar lista: " .. name end
					local criarPage = tela:FindFirstChild("Page_CRIATIVO")
						or (_G.AbyssDIETabs and _G.AbyssDIETabs.pages and _G.AbyssDIETabs.pages["CRIATIVO"])
					if criarPage then abyssShowPage("CRIATIVO", criarPage) end
					task.defer(function()
						if _G.AbyssStartReRecord then pcall(_G.AbyssStartReRecord) end
					end)
					task.delay(0.25, stopHoldVisual)
				else
					holdRing.Size = UDim2.new(t*1.2, 0, t*1.2, 0)
				end
			end)
		end)
		placeBtn.MouseButton1Up:Connect(function()
			if longPressDone then stopHoldVisual() return end
			local heldFor = tick() - holdStart
			stopHoldVisual()
			if heldFor < HOLD_TIME then
				local list = getPropsList(BuildPresets[name])
				if #list == 0 then
					if placeStatusLbl then placeStatusLbl.Text = "Build sem lista (segure 📦 pra gravar)" end
					return
				end
				if isPlacing then
					isPlacing = false
					if placeStatusLbl then placeStatusLbl.Text = "Cancelado" end
					return
				end
				autoPlacePropsList(list, name)
			end
		end)
		placeBtn.MouseLeave:Connect(function()
			if holding and not longPressDone then stopHoldVisual() end
		end)

		-- − remove último prop do mapa
		local remLastBtn = Instance.new("TextButton")
		remLastBtn.Text = "−"
		remLastBtn.Size = UDim2.new(0.12,0,0.75,0)
		remLastBtn.Position = UDim2.new(0.68,0,0.12,0)
		remLastBtn.BackgroundColor3 = Color3.fromRGB(180, 120, 40)
		remLastBtn.TextColor3 = STYLES.TextColor
		remLastBtn.Font = Enum.Font.SourceSansBold
		remLastBtn.TextSize = 14
		remLastBtn.Parent = card
		applyStyle(remLastBtn, 3, true)
		remLastBtn.MouseButton1Click:Connect(function()
			deleteLastMapProp()
			task.delay(0.3, function() rebindPropsToBuild() end)
		end)

		-- ❌ excluir build
		local delBtn = Instance.new("TextButton")
		delBtn.Text = "❌"
		delBtn.Size = UDim2.new(0.13,0,0.75,0)
		delBtn.Position = UDim2.new(0.81,0,0.12,0)
		delBtn.BackgroundColor3 = STYLES.RedColor
		delBtn.TextColor3 = STYLES.TextColor
		delBtn.Font = Enum.Font.SourceSansBold
		delBtn.TextSize = 9
		delBtn.Parent = card
		applyStyle(delBtn, 3, true)
		delBtn.MouseButton1Click:Connect(function()
			pendingDeleteName = name
			confirmLbl.Text = 'Excluir "' .. name .. '"?'
			confirmFrame.Visible = true
		end)
	end
end

