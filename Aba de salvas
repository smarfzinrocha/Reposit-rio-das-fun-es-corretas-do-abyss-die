local function getPlacePos(index, elevated)
	local char = LP.Character
	if not char then return nil end
	local hrp = char:FindFirstChild("HumanoidRootPart")
	if not hrp then return nil end
	local row = math.floor((index - 1) / 4)
	local col = (index - 1) % 4
	local xOffset = (col - 1.5) * 5
	local zOffset = 8 + row * 5
	local yBoost = elevated and (12 + row * 3) or 0
	local basePos = hrp.Position + hrp.CFrame.LookVector * zOffset + hrp.CFrame.RightVector * xOffset + Vector3.new(0, yBoost, 0)
	if elevated then return basePos, Workspace.Terrain end
	local rp = RaycastParams.new()
	rp.FilterDescendantsInstances = {char}
	rp.FilterType = Enum.RaycastFilterType.Exclude
	local hit = Workspace:Raycast(basePos + Vector3.new(0, 8, 0), Vector3.new(0, -20, 0), rp)
	if hit then return hit.Position, hit.Instance end
	return basePos - Vector3.new(0, 3, 0), Workspace.Terrain
end

local function equipPropMaker()
	local char = LP.Character
	if not char then return nil end
	local humanoid = char:FindFirstChildOfClass("Humanoid")
	if not humanoid then return nil end
	local tool = char:FindFirstChild("PropMaker")
	if tool then return tool end
	local backpack = LP:FindFirstChild("Backpack")
	if backpack then
		tool = backpack:FindFirstChild("PropMaker")
		if tool then
			humanoid:EquipTool(tool)
			task.wait(0.25)
			return char:FindFirstChild("PropMaker")
		end
	end
	return nil
end

local function placeOneProp(propData, index, elevated)
	local tool = equipPropMaker()
	if not tool then return false end
	local tmake = tool:FindFirstChild("Tool_PropMake")
	if not tmake then return false end
	local pos, chao = getPlacePos(index, elevated)
	if not pos then return false end
	pcall(function()
		local remotes = ReplicatedStorage:FindFirstChild("Remotes")
		if remotes and remotes:FindFirstChild("TelemetryClientInteraction") then
			remotes.TelemetryClientInteraction:FireServer("filterClick", {
				name = propData.name, itemType = "Props", filter = "All"
			})
		end
	end)
	task.wait(0.08)
	pcall(function()
		local RE = ReplicatedStorage:FindFirstChild("RE")
		if RE then
			local clearTools = RE:FindFirstChild("1Clea1rTool1s")
			if clearTools then
				clearTools:FireServer("RequestingPropName", propData.name, propData.category)
			end
		end
	end)
	task.wait(0.18)
	pcall(function() tmake:FireServer(chao or Workspace.Terrain, pos) end)
	return true
end

local placeStatusLbl -- forward

local function deleteLastMapProp()
	local props = scanMapProps()
	if #props == 0 then
		if placeStatusLbl then placeStatusLbl.Text = "Nenhum prop no mapa" end
		return false
	end
	local prop = props[#props]
	pcall(function()
		for _, n in ipairs({"DestroyProp", "DeleteProp", "RemoveProp", "Delete"}) do
			local r = prop:FindFirstChild(n, true)
			if r then
				if r:IsA("RemoteEvent") then r:FireServer()
				elseif r:IsA("RemoteFunction") then r:InvokeServer() end
			end
		end
		prop:Destroy()
	end)
	if placeStatusLbl then placeStatusLbl.Text = "Último prop removido" end
	return true
end

local function autoPlacePropsList(propsList, buildName)
	if isPlacing then return end
	if not propsList or #propsList == 0 then
		if placeStatusLbl then placeStatusLbl.Text = "Sem lista de props nesta build" end
		return
	end
	local missing, alreadyOk = getMissingProps(buildName)
	if #missing == 0 then
		if placeStatusLbl then
			placeStatusLbl.Text = "Todos os props já estão no mapa (" .. alreadyOk .. ")"
			task.delay(2.5, function() if placeStatusLbl then placeStatusLbl.Text = "" end end)
		end
		return
	end
	isPlacing = true
	task.spawn(function()
		if placeStatusLbl then placeStatusLbl.Text = ("Faltam %d prop(s)..."):format(#missing) end
		for i, item in ipairs(missing) do
			if not isPlacing then break end
			if placeStatusLbl then
				placeStatusLbl.Text = ("Colocando faltante %d/%d: %s"):format(i, #missing, item.propData.name)
			end
			placeOneProp(item.propData, i, true)
			task.wait(0.85)
		end
		-- remove o último prop colocado (cópia extra)
		task.wait(0.3)
		deleteLastMapProp()
		isPlacing = false
		task.wait(0.35)
		rebindPropsToBuild()
		if placeStatusLbl then
			placeStatusLbl.Text = ("Pronto: +%d | já tinha %d"):format(#missing, alreadyOk)
			task.wait(2.5)
			placeStatusLbl.Text = ""
		end
	end)
end

