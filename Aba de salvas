	lbl.Text, lbl.Size = text, UDim2.new(CONTENT_WIDTH,0,0,h or 14)
	lbl.BackgroundTransparency, lbl.TextColor3 = 1, STYLES.TextColor
	lbl.Font, lbl.TextSize, lbl.TextWrapped, lbl.TextXAlignment = Enum.Font.SourceSans, fs or 10, true, Enum.TextXAlignment.Center
	lbl.Parent = parent
	return lbl
end

