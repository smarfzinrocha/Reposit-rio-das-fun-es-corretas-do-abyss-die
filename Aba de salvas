-- ====================== FOLLOW + ANIMAÇÃO + COR (método ybyss) ======================
local RS = game:GetService("RunService")
RS.Heartbeat:Connect(function()
	-- lê sinais da aba Ajustes (pet / escala / alvo)
	local s = _G.AbyssShared
	if s then
		if s.petMode ~= nil then petMode = s.petMode end
		if s.buildScale then buildScale = s.buildScale end
		if s.followTargetName and Players:FindFirstChild(s.followTargetName) then
			followTargetPlayer = Players[s.followTargetName]
		end
	end
	if not petMode then return end
	local entry = BuildPresets[CurrentBuild]
	local offsets = getOffsets(entry)
	if not offsets then return end

	local targetPlr = followTargetPlayer or LP
	local character = targetPlr and targetPlr.Character
	local root = character and character:FindFirstChild("HumanoidRootPart")
	local hum = character and character:FindFirstChildOfClass("Humanoid")
	if not root then return end

	local baseCF = root.CFrame
	local scale = buildScale or 1
	local totalOffsets = #offsets

	local isMoving = hum and hum.MoveDirection.Magnitude > 0.1
	local currentAnimKeyframeList = nil
	if activeEmoteAnim then
		currentAnimKeyframeList = activeEmoteAnim
		if tick() - activeEmoteTime > 5 then activeEmoteAnim = nil end
	elseif isMoving and BuildAnimations[CurrentBuild] and BuildAnimations[CurrentBuild].Walk then
		local n = ActiveAnimations[CurrentBuild] and ActiveAnimations[CurrentBuild].Walk
		if n and BuildAnimations[CurrentBuild].Walk[n] then currentAnimKeyframeList = BuildAnimations[CurrentBuild].Walk[n] end
	elseif not isMoving and BuildAnimations[CurrentBuild] and BuildAnimations[CurrentBuild].Idle then
		local n = ActiveAnimations[CurrentBuild] and ActiveAnimations[CurrentBuild].Idle
		if n and BuildAnimations[CurrentBuild].Idle[n] then currentAnimKeyframeList = BuildAnimations[CurrentBuild].Idle[n] end
	end

	local activeFrame = nil
	if currentAnimKeyframeList and #currentAnimKeyframeList > 0 then
		activeFrame = currentAnimKeyframeList[(math.floor(tick() * 4) % #currentAnimKeyframeList) + 1]
	end

	for idx, prop in pairs(boundProps) do
		if prop and prop.Parent and not isCharacterOrPlayer(prop) then
			local targetCF, itemColor
			if idx <= totalOffsets then
				local data = offsets[idx]
				local relCF
				if typeof(data) == "Vector3" then relCF = CFrame.new(data)
				elseif typeof(data) == "CFrame" then relCF = data
				elseif typeof(data) == "table" then
					relCF = data.CF or CFrame.new()
					itemColor = data.Color
				end
				if activeFrame and activeFrame[idx] then relCF = activeFrame[idx] end
				if relCF then
					targetCF = baseCF * CFrame.new(relCF.Position * scale) * relCF.Rotation
				end
			else
				local e = idx - totalOffsets
				targetCF = baseCF * CFrame.new(0, 3 + e * 0.5, 2 + e * 0.2)
			end
			if targetCF then
				local cfR = boundPropRemotes[prop]
				if not cfR then
					cfR = prop:FindFirstChild("SetCurrentCFrame", true)
					if cfR then boundPropRemotes[prop] = cfR end
				end
				if cfR then
					task.spawn(function()
						pcall(function()
							if cfR:IsA("RemoteFunction") then cfR:InvokeServer(targetCF)
							elseif cfR:IsA("RemoteEvent") then cfR:FireServer(targetCF) end
						end)
					end)
				end
				if itemColor then applyPropColor(prop, itemColor) end
			end
		end
	end
end)

