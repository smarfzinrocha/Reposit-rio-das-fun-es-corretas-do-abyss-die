local function abyssShowPage(pageName, pg)
	if pg and pg.Parent then _G.AbyssDIETabs.pages[pageName] = pg end
	_G.AbyssDIETabs.current = pageName
	for name, p in pairs(_G.AbyssDIETabs.pages) do
		if p and p.Parent then p.Visible = (name == pageName) end
	end
	for _, c in ipairs(tela:GetChildren()) do
		if c:IsA("ScrollingFrame") or (c:IsA("Frame") and tostring(c.Name):sub(1,5) == "Page_") then
			local reg = false
			for _, p in pairs(_G.AbyssDIETabs.pages) do if p == c then reg = true break end end
			if not reg then c.Visible = false end
		end
	end
	if pg and pg.Parent then
		pg.Visible = true
		if applyThemeToPage then pcall(applyThemeToPage, pg) end
	end
end


local STYLES = {
	CardColor = Color3.fromRGB(18, 18, 22),
	StrokeColor = Color3.fromRGB(0, 140, 255),
