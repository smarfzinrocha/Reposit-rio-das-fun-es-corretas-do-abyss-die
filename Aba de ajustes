local function updatePlayerList()
	for _, c in ipairs(playerScroll:GetChildren()) do
		if not c:IsA("UIListLayout") then c:Destroy() end
	end
	for _, plr in ipairs(Players:GetPlayers()) do
		local isCurrent = (followTargetPlayer == plr)
		local pBtn = Instance.new("TextButton")
		pBtn.Text = (isCurrent and "▶ " or "  ") .. plr.DisplayName .. " (@" .. plr.Name .. ")"
		pBtn.Size = UDim2.new(1,0,0,16)
		pBtn.BackgroundColor3 = isCurrent and STYLES.AccentColor or STYLES.CardColor
		pBtn.TextColor3 = STYLES.TextColor
		pBtn.Font = Enum.Font.SourceSansBold
		pBtn.TextSize = 8
		pBtn.TextXAlignment = Enum.TextXAlignment.Left
		pBtn.Parent = playerScroll
		applyStyle(pBtn, 3, true)
		local pad = Instance.new("UIPadding")
		pad.PaddingLeft = UDim.new(0,4)
		pad.Parent = pBtn
		pBtn.MouseButton1Click:Connect(function()
			followTargetPlayer = plr
			TargetBtn.Text = "ALVO: " .. plr.Name
			_G.AbyssShared.followTargetName = plr.Name -- sinal pras outras abas
			updatePlayerList()
		end)
	end
end

