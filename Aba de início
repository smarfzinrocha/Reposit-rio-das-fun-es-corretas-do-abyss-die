local function updateAntiSeatState()
	local char = LP.Character
	local hum = char and char:FindFirstChildOfClass("Humanoid")
	if hum then
		hum:SetStateEnabled(Enum.HumanoidStateType.Seated, not antiSeatEnabled)
		if antiSeatEnabled and hum.Sit then
			hum.Sit = false
		end
	end
end

local function syncAntiSeatBtn()
	-- sempre lê o estado compartilhado pra não dessincronizar ao voltar na aba
	antiSeatEnabled = (_G.AbyssShared and _G.AbyssShared.antiSeatEnabled) or antiSeatEnabled
	if antiSeatEnabled then
		AntiSeatBtn.Text = "✅ ANTI-SEAT: ON"
		AntiSeatBtn.BackgroundColor3 = STYLES.GreenColor
	else
		AntiSeatBtn.Text = "🚫 ANTI-SEAT: OFF"
		AntiSeatBtn.BackgroundColor3 = STYLES.CardColor
	end
	updateAntiSeatState()
end

