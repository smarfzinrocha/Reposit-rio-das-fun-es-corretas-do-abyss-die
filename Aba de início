local function applyStyle(inst, r, hasStroke, col)
	if r then local c = inst:FindFirstChildOfClass("UICorner") or Instance.new("UICorner") c.CornerRadius = UDim.new(0,r) c.Parent = inst end
	if hasStroke then
		local s = nil
		for _, ch in ipairs(inst:GetChildren()) do
			if ch:IsA("UIStroke") and ch.ApplyStrokeMode == Enum.ApplyStrokeMode.Border then s = ch break end
		end
		if not s then s = Instance.new("UIStroke") s.ApplyStrokeMode = Enum.ApplyStrokeMode.Border s.Parent = inst end
		s.Color = col or STYLES.StrokeColor
		s.Thickness = 1
	end
end
local function createStyledBtn(text, parent, h, strokeCol)
	local btn = Instance.new("TextButton")
	btn.Text, btn.Size = text, UDim2.new(CONTENT_WIDTH,0,0,h or BTN_H)
