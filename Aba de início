-- Loop de follow dos presets (lê escala/alvo/petMode da aba Ajustes)
RS.Heartbeat:Connect(function()
	local s = _G.AbyssShared
	if s then
		if s.petMode ~= nil then petMode = s.petMode end
		if s.buildScale then buildScale = s.buildScale end
	end
	if not petMode then return end
	local offsets = BuildPresets[CurrentBuild]
	local targetName = s and s.followTargetName
	local targetPlr = (targetName and Players:FindFirstChild(targetName)) or LP
	local character = targetPlr and targetPlr.Character
	local root = character and character:FindFirstChild("HumanoidRootPart")
	if not root or not offsets then return end
	local baseCF = root.CFrame
	local scale = buildScale or 1
	for idx, prop in pairs(boundProps) do
		if prop and prop.Parent and not isCharacterOrPlayer(prop) then
			local data = offsets[idx]
			local relCF
			if typeof(data) == "Vector3" then relCF = CFrame.new(data)
			elseif typeof(data) == "CFrame" then relCF = data
			elseif typeof(data) == "table" then relCF = data.CF or CFrame.new()
			end
			if relCF then
				local pos = relCF.Position * scale
				local targetCF = baseCF * CFrame.new(pos) * relCF.Rotation
				pcall(function()
					if prop:IsA("Model") then prop:PivotTo(targetCF)
					elseif prop:IsA("BasePart") then prop.CFrame = targetCF end
				end)
				local cfR = boundPropRemotes[prop]
				if not cfR then
					cfR = prop:FindFirstChild("SetCurrentCFrame", true)
					if cfR then boundPropRemotes[prop] = cfR end
				end
				if cfR then
					if cfR:IsA("RemoteEvent") then pcall(function() cfR:FireServer(targetCF) end)
					elseif cfR:IsA("RemoteFunction") then task.spawn(function() pcall(function() cfR:InvokeServer(targetCF) end) end) end
				end
			end
		end
	end
end)

