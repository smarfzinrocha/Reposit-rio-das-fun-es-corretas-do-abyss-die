local function seatGetPlacePos(index)
	local char = LP.Character
	if not char then return nil end
	local hrp = char:FindFirstChild("HumanoidRootPart")
	if not hrp then return nil end
	local row = math.floor((index - 1) / 4)
	local col = (index - 1) % 4
	local xOffset = (col - 1.5) * 5
	local zOffset = 8 + row * 5
	local yBoost = 12 + row * 3 -- no ar
	local basePos = hrp.Position + hrp.CFrame.LookVector * zOffset + hrp.CFrame.RightVector * xOffset + Vector3.new(0, yBoost, 0)
	return basePos, Workspace.Terrain
end

local function seatEquipPropMaker()
	local char = LP.Character
	if not char then return nil end
	local humanoid = char:FindFirstChildOfClass("Humanoid")
	if not humanoid then return nil end
	local tool = char:FindFirstChild("PropMaker")
	if tool then return tool end
	local backpack = LP:FindFirstChild("Backpack")
	if backpack then
		tool = backpack:FindFirstChild("PropMaker")
		if tool then
			humanoid:EquipTool(tool)
			task.wait(0.25)
			return char:FindFirstChild("PropMaker")
		end
	end
	return nil
end

local function seatPlaceOneProp(propData, index)
	local tool = seatEquipPropMaker()
	if not tool then return false end
	local tmake = tool:FindFirstChild("Tool_PropMake")
	if not tmake then return false end
	local pos, chao = seatGetPlacePos(index)
	if not pos then return false end
	pcall(function()
		local remotes = ReplicatedStorage:FindFirstChild("Remotes")
		if remotes and remotes:FindFirstChild("TelemetryClientInteraction") then
			remotes.TelemetryClientInteraction:FireServer("filterClick", {
				name = propData.name, itemType = "Props", filter = "All"
			})
		end
	end)
	task.wait(0.08)
	pcall(function()
		local RE = ReplicatedStorage:FindFirstChild("RE")
		if RE then
			local clearTools = RE:FindFirstChild("1Clea1rTool1s")
			if clearTools then
				clearTools:FireServer("RequestingPropName", propData.name, propData.category)
			end
		end
	end)
	task.wait(0.18)
	pcall(function() tmake:FireServer(chao or Workspace.Terrain, pos) end)
	return true
end

local function seatGetCFRemote(prop)
