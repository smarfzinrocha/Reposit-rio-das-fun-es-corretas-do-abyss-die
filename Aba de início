	pcall(function()
		if prop.Parent then
			for _, n in ipairs({ "DestroyProp", "DeleteProp", "RemoveProp", "Delete", "Tool_PropDelete" }) do
				local r = prop:FindFirstChild(n, true)
				if r then
					if r:IsA("RemoteEvent") then r:FireServer()
					elseif r:IsA("RemoteFunction") then r:InvokeServer() end
				end
			end
			-- tenta via RE global do jogo
			local RE = ReplicatedStorage:FindFirstChild("RE")
			if RE then
				for _, child in ipairs(RE:GetChildren()) do
					local ln = string.lower(child.Name)
					if ln:find("delete", 1, true) or ln:find("destroy", 1, true) or ln:find("remove", 1, true) then
						pcall(function()
							if child:IsA("RemoteEvent") then child:FireServer(prop)
							elseif child:IsA("RemoteFunction") then child:InvokeServer(prop) end
						end)
					end
				end
			end
			prop:Destroy()
		end
	end)
end

local function seatIsOurTrap(seatPart)
	if not seatPart then return nil end
	for _, entry in ipairs(seatTrapProps) do
		if not entry.used and entry.prop and entry.prop.Parent then
			if seatPart == entry.prop or seatPart:IsDescendantOf(entry.prop) then
				return entry
			end
			local anc = seatPart
			for _ = 1, 8 do
				if not anc then break end
				if anc == entry.prop then return entry end
				anc = anc.Parent
			end
		end
	end
	return nil
end

local function seatTrigger(entry, victimPlr)
	if not entry or entry.used then return end
	if entry.targetPlr and victimPlr and entry.targetPlr ~= victimPlr then return end
	entry.used = true
	local prop = entry.prop
	if not prop or not prop.Parent then return end

	if entry.mode == "matar" then
		seatMoveProp(prop, CFrame.new(0, -800, 0))
		task.defer(function()
			task.wait(0.05)
			seatDeleteProp(prop)
		end)
		if seatStatusLbl then seatStatusLbl.Text = "💀 Matou: " .. (victimPlr and victimPlr.Name or "?") end
	else
		entry.pulling = true
		entry.dest = seatDest
		seatMoveProp(prop, seatGetPullCF())
		if seatStatusLbl then
			local destName = (seatDest == "preso") and "Preso" or "você"
			seatStatusLbl.Text = ("🧲 Puxou %s → %s"):format(victimPlr and victimPlr.Name or "?", destName)
		end
	end
end

if _G.AbyssSeatTrapConn then pcall(function() _G.AbyssSeatTrapConn:Disconnect() end) end
_G.AbyssSeatTrapConn = RS.Heartbeat:Connect(function()
	if not seatArmed then return end
	if #seatTrapProps == 0 then return end
	local t = tick()
	local sx, sy, sz = t * 40, t * 55, t * 35

	for _, entry in ipairs(seatTrapProps) do
		local prop = entry and entry.prop
		if prop and prop.Parent then
			if entry.pulling then
				local destCF = (entry.dest == "preso") and SEAT_PRESO_CF or seatGetPullCF()
				seatMoveProp(prop, destCF)
				local propPos
				pcall(function()
					if prop:IsA("Model") then propPos = prop:GetPivot().Position
					elseif prop:IsA("BasePart") then propPos = prop.Position end
				end)
				if propPos and (propPos - destCF.Position).Magnitude < 12 then
					seatDeleteProp(prop)
					entry.prop = nil
					entry.pulling = false
					if seatStatusLbl then seatStatusLbl.Text = "🧲 Chegou — prop removido" end
				end
			elseif not entry.used then
				local target = entry.targetPlr
				local tRoot = target and target.Parent and target.Character and target.Character:FindFirstChild("HumanoidRootPart")
				if tRoot then
					seatMoveProp(prop, CFrame.new(tRoot.Position) * CFrame.Angles(sx, sy, sz))
				end
			end
		end
	end

	for _, plr in ipairs(Players:GetPlayers()) do
		if plr ~= LP then
			local hum = plr.Character and plr.Character:FindFirstChildOfClass("Humanoid")
			if hum and hum.Sit and hum.SeatPart then
				local entry = seatIsOurTrap(hum.SeatPart)
				if entry then seatTrigger(entry, plr) end
			end
		end
	end
end)

local function seatScanNewProps(beforeSet)
	local found = {}
	local targetName = "Prop" .. OwnerName
	local function check(v)
		if beforeSet[v] then return end
		if isCharacterOrPlayer(v) then return end
		local n = tostring(v.Name or "")
		if n == targetName or (n:sub(1, 4) == "Prop" and n:find(OwnerName, 1, true)) then
			table.insert(found, v)
		end
	end
	local wsCom = workspace:FindFirstChild("WorkspaceCom")
	if wsCom then
		for _, folder in ipairs(wsCom:GetChildren()) do
			for _, v in ipairs(folder:GetChildren()) do check(v) end
		end
	end
	for _, v in ipairs(workspace:GetChildren()) do check(v) end
	return found
end

local function seatSpawnTraps()
	if seatSpawning then return end
	local targets = seatGetSelectedList()
	if #targets == 0 then
		if seatStatusLbl then seatStatusLbl.Text = "Selecione pelo menos 1 pessoa" end
		return
	end
	if #targets > 15 then
		if seatStatusLbl then seatStatusLbl.Text = "Máximo 15 pessoas" end
		return
	end
	local propData = SEAT_PROPS[seatPropIndex]
	if not propData then return end
	seatSpawning = true
	if seatStatusLbl then
		seatStatusLbl.Text = ("Spawnando %dx %s no ar (%s)..."):format(#targets, propData.label, seatMode)
	end
	task.spawn(function()
		for i, targetPlr in ipairs(targets) do
			local beforeSet = {}
			for _, p in ipairs(scanMapProps()) do beforeSet[p] = true end
			seatPlaceOneProp(propData, i) -- no ar
			task.wait(0.85)
			local news = seatScanNewProps(beforeSet)
			for _, p in ipairs(news) do
				table.insert(seatTrapProps, {
					prop = p,
					mode = seatMode,
					used = false,
					targetPlr = targetPlr, -- armadilha ligada a essa pessoa
				})
			end
		end
		seatSpawning = false
		if seatStatusLbl then
			seatStatusLbl.Text = ("✅ %d armadilha(s) [%s]"):format(#seatTrapProps, seatMode)
		end
	end)
end

local function seatClearTraps()
	seatArmed = false
	if SeatArmBtn then
		SeatArmBtn.Text = "⚡ ATIVAR ARMADILHA"
		SeatArmBtn.BackgroundColor3 = STYLES.AccentColor
	end
	local n = #seatTrapProps
	for i = #seatTrapProps, 1, -1 do
		local entry = seatTrapProps[i]
		if entry and entry.prop then
			seatDeleteProp(entry.prop)
		end
		seatTrapProps[i] = nil
	end
	seatTrapProps = {}
	if seatStatusLbl then
		seatStatusLbl.Text = ("Armadilhas limpas (%d)"):format(n)
		task.delay(2, function()
			if seatStatusLbl and seatStatusLbl.Text:find("limpas") then
				seatStatusLbl.Text = ""
			end
		end)
	end
end

local function seatActivateTraps()
	if #seatTrapProps == 0 then
		if seatStatusLbl then seatStatusLbl.Text = "Spawn as armadilhas antes" end
		return
	end
	local targets = seatGetSelectedList()
	if #targets == 0 then
		if seatStatusLbl then seatStatusLbl.Text = "Selecione pelo menos 1 pessoa" end
		return
	end
	-- arma no modo escolhido e já processa quem já estiver sentado
	seatArmed = true
	if SeatArmBtn then
		SeatArmBtn.Text = "✅ ARMADILHA ATIVA (" .. string.upper(seatMode) .. ")"
		SeatArmBtn.BackgroundColor3 = STYLES.GreenColor
	end
	-- atualiza modo das armadilhas pro modo atual do botão
	for _, entry in ipairs(seatTrapProps) do
		if entry and not entry.used then
			entry.mode = seatMode
		end
	end
	-- trigger imediato em quem já sentou
	for _, plr in ipairs(targets) do
		local char = plr.Character
		local hum = char and char:FindFirstChildOfClass("Humanoid")
		if hum and hum.Sit and hum.SeatPart then
			local entry = seatIsOurTrap(hum.SeatPart)
			if entry then
				seatTrigger(entry, plr)
			end
		end
	end
	if seatStatusLbl then
		seatStatusLbl.Text = ("⚡ Ativo: %s | %d armadilha(s)"):format(seatMode, #seatTrapProps)
	end
end

