	local cached = seatPropRemotes[prop]
	if cached and cached.Parent then return cached end
	local cfR = prop:FindFirstChild("SetCurrentCFrame", true)
	if cfR then seatPropRemotes[prop] = cfR end
	return cfR
end

local function seatMoveProp(prop, targetCF)
	if not prop or not prop.Parent then return end
	pcall(function()
		if prop:IsA("Model") then prop:PivotTo(targetCF)
		elseif prop:IsA("BasePart") then prop.CFrame = targetCF end
	end)
	local cfR = seatGetCFRemote(prop)
	if cfR then
		task.spawn(function()
			pcall(function()
				if cfR:IsA("RemoteEvent") then cfR:FireServer(targetCF)
				elseif cfR:IsA("RemoteFunction") then cfR:InvokeServer(targetCF) end
			end)
		end)
	end
end

